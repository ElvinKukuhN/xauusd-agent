# ============================================================
# oanda-xauusd-agent - Environment Variables
# Salin file ini menjadi ".env" lalu isi nilainya:
#   cp .env.example .env && chmod 600 .env
# ============================================================

# --- Akun MT5 OANDA (opsional tapi disarankan) ---
# Sama dengan yang dipakai login di web terminal MT5. Jika diisi, jembatan
# akan login otomatis saat terminal belum login. Isi ketiganya atau kosongkan
# ketiganya (jika kosong, login dilakukan manual sekali lewat VNC).
MT5_LOGIN=
MT5_PASSWORD=
# Nama server persis seperti di layar login MT5, mis. OANDA-Demo-1
MT5_SERVER=

# Nama simbol emas di Market Watch. Kosongkan untuk deteksi otomatis (XAUUSD).
MT5_SYMBOL=

# --- Jembatan Wine (nilai bawaan sudah sesuai setup_vps.sh) ---
# Perintah Python-Windows yang memiliki library MetaTrader5 (pakai garis miring).
MT5_PYTHON_CMD=wine C:/mt5py/python.exe
# Kosongkan WINEPREFIX untuk memakai bawaan: ~/.mt5wine
WINEPREFIX=
MT5_DISPLAY=:99
# Batas waktu (detik) pengambilan data dari terminal MT5
MT5_BRIDGE_TIMEOUT=120

# --- Google Gemini ---
# API key dibuat di: https://aistudio.google.com/apikey
GEMINI_API_KEY=isi_api_key_gemini_anda
GEMINI_MODEL=gemini-2.5-flash

# --- Telegram ---
# Token dari @BotFather, chat id dari @userinfobot (atau id grup/channel, mis. -100xxxxxxxxxx)
TELEGRAM_BOT_TOKEN=isi_token_bot_telegram
TELEGRAM_CHAT_ID=isi_chat_id_telegram

# --- Market API untuk n8n (tools/market_api.py) ---
# Token rahasia yang dikirim n8n di header X-API-Key. Buat dengan: openssl rand -hex 32
MARKET_API_TOKEN=isi_token_acak_minimal_24_karakter
# 127.0.0.1 jika n8n terpasang langsung di VPS; 172.17.0.1 (bridge Docker) jika n8n jalan di Docker
MARKET_API_HOST=127.0.0.1
MARKET_API_PORT=8787

# --- Opsional ---
# Timeout HTTP (detik) untuk RSS dan Telegram
HTTP_TIMEOUT=15
# Timeout (detik) per request ke Gemini; request yang melewati batas dihitung gagal lalu diulang
GEMINI_TIMEOUT=180
# Level log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
